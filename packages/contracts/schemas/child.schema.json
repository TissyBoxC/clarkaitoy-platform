{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprout.example/contracts/schemas/child.schema.json",
  "title": "Child profile contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "child_id",
    "family_id",
    "nickname",
    "age_tier",
    "interests",
    "content_categories",
    "guardian_consent"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "child_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "family_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "nickname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "age_tier": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/age_tier"
    },
    "interests": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      }
    },
    "content_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/content_category"
      }
    },
    "guardian_consent": {
      "type": "boolean",
      "const": true
    }
  }
}
