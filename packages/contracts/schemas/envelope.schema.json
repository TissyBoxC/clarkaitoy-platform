{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprout.example/contracts/schemas/envelope.schema.json",
  "title": "API response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "data",
    "error"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "data": {},
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://sprout.example/contracts/errors/error_response.schema.json#/$defs/error"
        }
      ]
    }
  }
}
