{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprout.example/contracts/schemas/audio_error.schema.json",
  "title": "Realtime audio error catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "codes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "catalog_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/audio_error"
      }
    }
  },
  "$defs": {
    "audio_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "source",
        "retryable",
        "diagnostic"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "source": {
          "type": "string",
          "enum": [
            "firmware",
            "voice_gateway"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "diagnostic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
