{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprout.example/contracts/schemas/device.schema.json",
  "title": "Device contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "product_family",
    "hardware_revision",
    "firmware_version",
    "protocol_version",
    "capabilities",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "device_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "family_id": {
      "oneOf": [
        {
          "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "product_family": {
      "type": "string",
      "const": "sprout"
    },
    "hardware_revision": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "firmware_version": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/firmware_version"
    },
    "protocol_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/device_capability"
      }
    },
    "status": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/device_status"
    },
    "activated_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    }
  }
}
