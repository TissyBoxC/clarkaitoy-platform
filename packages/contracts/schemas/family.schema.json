{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprout.example/contracts/schemas/family.schema.json",
  "title": "Family contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "family_id",
    "family_name",
    "owner_user_id",
    "members",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "family_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "family_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "owner_user_id": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "role"
        ],
        "properties": {
          "user_id": {
            "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/identifier"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "guardian",
              "viewer"
            ]
          }
        }
      }
    },
    "created_at": {
      "$ref": "https://sprout.example/contracts/schemas/common.schema.json#/$defs/timestamp"
    }
  }
}
