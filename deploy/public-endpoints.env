# Canonical public endpoints for 如此萌屋 cloud deployments.
#
# This is the single source of truth for public hostnames. Change hostnames
# here and let deployment tooling pass the resulting URLs to clients.
SPROUT_PUBLIC_BASE_DOMAIN=clarkhub.cn
SPROUT_API_PUBLIC_URL=https://api.clarkhub.cn
SPROUT_VOICE_PUBLIC_URL=https://voice.clarkhub.cn
SPROUT_SUB_PUBLIC_URL=https://sub.clarkhub.cn
SPROUT_ADMIN_PUBLIC_URL=https://admin.clarkhub.cn

# MQTT endpoint is intentionally blank until the broker hostname is confirmed.
SPROUT_MQTT_PUBLIC_HOST=
