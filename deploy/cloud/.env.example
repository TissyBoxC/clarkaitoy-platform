# ============================================================================
# 如此萌屋云端部署环境变量
#
# 复制为 .env 后再修改。每行含义见同目录 README.md。
# 生产环境不要复用本文件中的占位值，也不要把 .env 提交到 Git。
# ============================================================================

# ---- PostgreSQL ----
SPROUT_POSTGRES_USER=sprout
SPROUT_POSTGRES_PASSWORD=replace-with-strong-random-password
SPROUT_POSTGRES_DB=sprout
SPROUT_DEVICE_PLATFORM_DATABASE_NAME=sprout_device_platform
SPROUT_SUB2API_DATABASE_NAME=sprout_sub2api

# ---- Redis ----
SPROUT_REDIS_PASSWORD=replace-with-strong-random-password

# ---- 服务端口与监听地址 ----
SPROUT_SERVICE_BIND_ADDRESS=127.0.0.1
SPROUT_MQTT_BIND_ADDRESS=127.0.0.1
SPROUT_MQTTS_BIND_ADDRESS=0.0.0.0
SPROUT_MQTT_UID=1883
SPROUT_MQTT_GID=1883
SPROUT_DEVICE_PLATFORM_UID=65532
SPROUT_DEVICE_PLATFORM_GID=65532
SPROUT_DEVICE_PLATFORM_PORT=8081
SPROUT_VOICE_GATEWAY_PORT=8082
SPROUT_ADMIN_WEB_PORT=8083
SPROUT_SUB2API_PORT=8084
SPROUT_MQTT_PORT=1883
SPROUT_MQTTS_PORT=8883

# ---- 镜像版本 ----
SPROUT_PLATFORM_VERSION=0.4.0
SPROUT_SUB2API_VERSION=0.2.14

# ---- 服务间共享密钥 ----
SPROUT_INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
SPROUT_AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
SPROUT_AI_CREDENTIAL_KEY=replace-with-at-least-32-random-characters
SPROUT_MFA_CREDENTIAL_KEY=replace-with-another-32-random-characters
SPROUT_AUTH_ACCESS_TOKEN_TTL=15m
SPROUT_AUTH_REFRESH_TOKEN_TTL=720h
SPROUT_MFA_CHALLENGE_TTL=5m

# ---- 家长手机号验证 ----
SPROUT_PHONE_VERIFICATION_MODE=disabled
SPROUT_ALLOW_LOCAL_SMS_BYPASS=false

# ---- AI 账号默认值 ----
SPROUT_AI_DEFAULT_BALANCE_USD=0
SPROUT_AI_DEFAULT_CONCURRENCY=1
SPROUT_AI_DEFAULT_MODELS=

# ---- Sub2API 出站域名白名单 ----
# 完整覆盖 Sub2API 的上游域名列表，不是追加。多个域名使用英文逗号分隔，
# 不要包含空格、协议或路径。必须包含全部实际使用的中转站域名。
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=sub.unsee.you,api.openai.com,api.anthropic.com,api.kimi.com,api.moonshot.ai,api.moonshot.cn,open.bigmodel.cn,api.minimaxi.com,api.minimax.io,opencode.ai,generativelanguage.googleapis.com,cloudcode-pa.googleapis.com,*.openai.azure.com

# ---- Sub2API ----
SPROUT_SUB2API_API_KEY=replace-with-key-that-exists-in-sub2api-database
# 公网域名统一维护在 ../public-endpoints.env。
SPROUT_SUB2API_ADMIN_EMAIL=admin@clarkhub.cn
SPROUT_SUB2API_ADMIN_PASSWORD=replace-with-strong-admin-password
SPROUT_SUB2API_JWT_SECRET=replace-with-at-least-32-random-characters
SPROUT_SUB2API_TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-by-openssl-rand-hex-32
SPROUT_TIMEZONE=Asia/Shanghai
